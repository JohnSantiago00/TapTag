# MongoDB Atlas connection used by the backend API and seed scripts.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=taptag
# TLS is auto-enabled for mongodb+srv:// URIs. Set MONGODB_TLS=true to force it
# for plain mongodb:// URIs, or false to disable the auto-detection.
# MONGODB_TLS=true

# Backend API
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed browser origins. "*" is fine for local dev
# but should be locked down in production, e.g. https://app.example.com
CORS_ORIGIN=*

# Set NODE_ENV=production for deployed environments.
# NODE_ENV=production

# Set TRUST_PROXY=true when running behind a reverse proxy / load balancer so
# rate limiting sees real client IPs instead of the proxy IP.
# TRUST_PROXY=true

# Per-IP request rate limit (fixed window).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300

# Firebase Auth token verification for protected user routes. Use the same
# project id configured in frontend/.env.
FIREBASE_PROJECT_ID=your-project-id
