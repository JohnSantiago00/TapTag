{
  "name": "taptag-root",
  "private": true,
  "scripts": {
    "postinstall": "npm install --prefix frontend && npm install --prefix backend",
    "start": "npm run start --prefix frontend",
    "web": "npm run web --prefix frontend",
    "android": "npm run android --prefix frontend",
    "ios": "npm run ios --prefix frontend",
    "start:tunnel": "npm run start:tunnel --prefix frontend",
    "setup": "npm run setup --prefix frontend && npm run setup --prefix backend",
    "doctor": "npm run doctor --prefix frontend",
    "first-run": "npm run first-run --prefix frontend",
    "api": "npm run start --prefix backend",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "smoke:api": "npm run smoke:api --prefix backend",
    "bootstrap": "npm run doctor --prefix frontend && npm run seed:knowledge --prefix backend",
    "seed:knowledge": "npm run seed:knowledge --prefix backend",
    "cleanup:knowledge": "npm run cleanup:knowledge --prefix backend",
    "docker:api": "docker compose --profile api up backend-api",
    "docker:frontend": "docker compose --profile frontend up frontend",
    "docker:seed": "docker compose run --rm backend-seed",
    "docker:cleanup": "docker compose run --rm backend-cleanup",
    "docker:backend:shell": "docker compose run --rm backend sh",
    "lint": "npm run lint --prefix frontend"
  }
}
